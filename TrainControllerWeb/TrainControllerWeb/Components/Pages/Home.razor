@page "/"
@rendermode InteractiveServer
@inject TrainCommandService TrainCommands
@inject RabbitMqService RabbitMq
@inject Esp32StatusService Esp32Status
@inject DetectorStatusService DetectorStatus
@inject FirmwareService Firmware
@implements IDisposable

<PageTitle>Train Controller</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="mb-0">Train Controller</h1>
    @if (RabbitMq.IsConnected)
    {
        <span class="badge bg-success">RabbitMQ</span>
    }
    else
    {
        <span class="badge bg-danger">RabbitMQ Disconnected</span>
    }
    @if (Esp32Status.IsAlive)
    {
        <span class="badge bg-success">ESP32 Alive</span>
    }
    else
    {
        <span class="badge bg-danger">ESP32 Offline</span>
    }
    @if (Esp32Status.LastSeen.HasValue)
    {
        <span class="text-muted small">last seen @((DateTime.UtcNow - Esp32Status.LastSeen.Value).TotalSeconds.ToString("0"))s ago</span>
    }
    @if (DetectorStatus.IsAlive)
    {
        <span class="badge bg-success">Detector Alive</span>
        <span class="text-muted small">uptime: @DetectorStatus.UptimeSeconds s</span>
    }
    else
    {
        <span class="badge bg-danger">Detector Offline</span>
    }
    @if (DetectorStatus.LastSeen.HasValue)
    {
        <span class="text-muted small">last seen @((DateTime.UtcNow - DetectorStatus.LastSeen.Value).TotalSeconds.ToString("0"))s ago</span>
    }
</div>

@if (Esp32Status.IsAlive)
{
    <div class="d-flex gap-3 mb-3 p-2 border rounded small font-monospace">
        <span>uptime: @Esp32Status.UptimeSeconds s</span>
        <span>cmds received: @Esp32Status.CmdsDispatched</span>
        <span class="@(Esp32Status.I2cFoundCount == 7 ? "text-success" : "text-danger")">
            I2C expanders: @Esp32Status.I2cFoundCount/7
        </span>
        <span class="@(Esp32Status.I2cErrors == 0 ? "text-success" : "text-danger")">
            I2C errors: @Esp32Status.I2cErrors
        </span>
        @if (Esp32Status.I2cScanAddrs.Length > 0)
        {
            <span>bus scan: @string.Join(", ", Esp32Status.I2cScanAddrs.Select(a => $"0x{a:X2}"))</span>
        }
    </div>
}

@if (!RabbitMq.IsConnected)
{
    <div class="alert alert-danger">
        Cannot reach RabbitMQ. Make sure it is running and the MQTT plugin is enabled.
    </div>
}

<h4>Track Layout</h4>
<img src="track_layout.png" alt="Track Layout"
     style="width:579px !important; height:auto !important; display:block;"
     class="mb-4" />

<h4>Sections</h4>
<div class="row g-2 mb-4">
    @for (int i = 0; i < 14; i++)
    {
        int idx = i;
        <div class="col-6 col-sm-4 col-md-3 col-xl-2">
            <div class="card h-100">
                <div class="card-body p-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-semibold">Section @(idx + 1)</span>
                        @{ var state = DetectorStatus.GetState(idx); }
                        <span class="badge @SectionStateCss(state)">@state</span>
                    </div>
                    <div class="small text-muted mb-1">Speed: @sectionSpeeds[idx]%</div>
                    <input type="range" class="form-range mb-2" min="0" max="100"
                           value="@sectionSpeeds[idx]"
                           @oninput="@(e  => sectionSpeeds[idx] = ParseInt(e.Value))"
                           @onchange="@(async e => await SendSection(idx + 1, ParseInt(e.Value), sectionDirections[idx]))" />
                    <div class="btn-group w-100 btn-group-sm">
                        <button class="btn @(sectionDirections[idx] == "forward" ? "btn-success" : "btn-outline-success")"
                                @onclick="@(async () => await SetDirection(idx, "forward"))">Fwd</button>
                        <button class="btn btn-outline-secondary"
                                @onclick="@(async () => await StopSection(idx))">Stop</button>
                        <button class="btn @(sectionDirections[idx] == "reverse" ? "btn-danger" : "btn-outline-danger")"
                                @onclick="@(async () => await SetDirection(idx, "reverse"))">Rev</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<h4>Turnouts</h4>
<div class="row g-2">
    @for (int i = 0; i < 6; i++)
    {
        int idx = i;
        <div class="col-6 col-sm-4 col-md-3 col-lg-auto">
            <div class="card h-100">
                <div class="card-body p-2 text-center">
                    <div class="fw-semibold mb-2">@(idx == 5 ? "X" : $"Turnout {idx + 1}")</div>
                    <div class="d-grid gap-1">
                        <button class="btn btn-sm @(turnoutPositions[idx] == "straight" ? "btn-primary" : "btn-outline-primary")"
                                @onclick="@(async () => await SetTurnout(idx, "straight"))">Straight</button>
                        <button class="btn btn-sm @(turnoutPositions[idx] == "diverge" ? "btn-warning" : "btn-outline-warning")"
                                @onclick="@(async () => await SetTurnout(idx, "diverge"))">Diverge</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@{
    var sensors   = DetectorStatus.AllSensors().ToList();
    var reporting = sensors.Count(s => s.HasData);
    var active    = sensors.Count(s => s.HasData && s.Triggered);
}

<div class="d-flex align-items-center gap-2 mt-4 mb-2">
    <h4 class="mb-0">Hall Sensors</h4>
    <span class="badge bg-secondary">@reporting/@sensors.Count reporting</span>
    <span class="badge @(active > 0 ? "bg-danger" : "bg-success")">@active triggered</span>
</div>

<div class="table-responsive mb-4">
    <table class="table table-sm table-bordered align-middle small font-monospace mb-0"
           style="max-width:760px;">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Chip</th>
                <th>Pin</th>
                <th>Sensor</th>
                <th>State</th>
                <th>Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in sensors)
            {
                <tr class="@(s.Index % 8 == 0 && s.Index > 0 ? "border-top border-2 border-dark" : null)">
                    <td class="text-muted">@s.Index</td>
                    <td>0x@s.Addr.ToString("X2")</td>
                    <td>@s.Pin</td>
                    <td>@s.Label</td>
                    <td>
                        @if (!s.HasData)
                        {
                            <span class="badge bg-secondary">no data</span>
                        }
                        else if (s.Triggered)
                        {
                            <span class="badge bg-danger">triggered</span>
                        }
                        else
                        {
                            <span class="badge bg-success">clear</span>
                        }
                    </td>
                    <td class="text-muted">
                        @(s.LastUpdate.HasValue
                            ? $"{(DateTime.UtcNow - s.LastUpdate.Value).TotalSeconds:0}s ago"
                            : "—")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h4 class="mt-4">Lights</h4>
<div class="card mb-4" style="max-width:320px;">
    <div class="card-body p-3 d-flex align-items-center justify-content-between">
        <div>
            <div class="fw-semibold">LED 1</div>
            <div class="small text-muted font-monospace">0x23 pin 4</div>
        </div>
        <div class="form-check form-switch fs-3 mb-0">
            <input class="form-check-input" type="checkbox" role="switch"
                   checked="@ledOn"
                   @onchange="@(async e => await SetLed(1, e.Value is bool b && b))" />
        </div>
    </div>
</div>

<h4 class="mt-4">Cooling</h4>
<div class="card mb-2" style="max-width:420px;">
    <div class="card-body p-3 d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-semibold">Temperature</span>
            <span class="small text-muted font-monospace ms-2">KY-013 &middot; GPIO34</span>
            @if (DetectorStatus.TemperatureSeen.HasValue)
            {
                <div class="small text-muted">
                    updated @((DateTime.UtcNow - DetectorStatus.TemperatureSeen.Value).TotalSeconds.ToString("0"))s ago
                </div>
            }
        </div>
        @if (DetectorStatus.TemperatureC is double tc)
        {
            <span class="badge fs-5 @TempCss(tc)">@tc.ToString("0.0") &deg;C</span>
        }
        else if (DetectorStatus.TemperatureError is not null)
        {
            <span class="badge bg-warning text-dark">@DetectorStatus.TemperatureError</span>
        }
        else
        {
            <span class="badge bg-secondary">no data</span>
        }
    </div>
</div>

<div class="card mb-4" style="max-width:420px;">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <span class="fw-semibold">Fans 1&ndash;4</span>
                <span class="small text-muted font-monospace ms-2">12 V &middot; GPIO18 &middot; 25 kHz PWM</span>
                <div class="small text-muted">
                    @if (DetectorStatus.FanAuto)
                    {
                        <span>auto &mdash; on above @FanOnC.ToString("0")&deg;C, off below @FanOffC.ToString("0")&deg;C</span>
                    }
                    else
                    {
                        <span class="text-warning-emphasis">manual override</span>
                    }
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge @(DetectorStatus.FanSpeed > 0 ? "bg-primary" : "bg-secondary")">
                    @(DetectorStatus.FanSpeed > 0 ? "running" : "off")
                </span>
                <div class="form-check form-switch fs-3 mb-0">
                    <input class="form-check-input" type="checkbox" role="switch"
                           checked="@(DetectorStatus.FanSpeed > 0)"
                           @onchange="@(async e => await SetFan(1, e.Value is bool b && b ? FanOn : FanOff))" />
                </div>
            </div>
        </div>
        @if (!DetectorStatus.FanAuto)
        {
            <button class="btn btn-sm btn-outline-primary w-100 mt-2"
                    @onclick="@(async () => await TrainCommands.SetFanAuto(1))">
                Return to automatic control
            </button>
        }
    </div>
</div>

<h4 class="mt-4">Firmware</h4>
<div class="card mb-4" style="max-width:620px;">
    <div class="card-body p-3">
        <div class="small text-muted mb-3">
            Updates are sent over Wi-Fi. The board downloads the image from this PC and
            reboots &mdash; sections stop and turnouts lose their position, so update with
            trains stopped.
        </div>

        @foreach (var dev in new[] { "detector", "controller" })
        {
            var img     = Firmware.Describe(dev);
            var running = dev == "detector" ? DetectorStatus.Version : Esp32Status.Version;
            var alive   = dev == "detector" ? DetectorStatus.IsAlive : Esp32Status.IsAlive;

            <div class="d-flex justify-content-between align-items-center border-top py-2">
                <div>
                    <span class="fw-semibold text-capitalize">@dev</span>
                    @if (!alive)
                    {
                        <span class="badge bg-danger ms-2">offline</span>
                    }
                    <div class="small text-muted font-monospace">
                        built: @(img.Exists ? $"{img.SizeText} · {img.BuiltLocal:yyyy-MM-dd HH:mm}" : "not built")
                    </div>
                    <div class="small text-muted font-monospace">
                        running: @(running ?? "unknown")
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-warning"
                        disabled="@(!img.Exists || !alive || otaSent.Contains(dev))"
                        @onclick="@(async () => await SendOta(dev))">
                    @(otaSent.Contains(dev) ? "Sent…" : "Update over Wi-Fi")
                </button>
            </div>
        }

        @if (otaSent.Count > 0)
        {
            <div class="small text-muted mt-2">
                Watch the <em>running</em> version and the uptime badge above: a successful
                update resets uptime and changes the version.
            </div>
        }
    </div>
</div>

@code {
    private bool ledOn;

    // Boards that have been sent an update this page-load. Only guards against
    // double-clicking; the firmware also refuses a second concurrent update.
    private readonly HashSet<string> otaSent = new();

    // Fans run flat out or not at all — no intermediate speeds wanted. The
    // firmware still takes any 0-100 duty, so this is purely a UI choice.
    private const int FanOff = 0;
    private const int FanOn  = 100;

    // Mirrors FAN_TEMP_ON_C / FAN_TEMP_OFF_C in the firmware's detect_config.h;
    // shown for information only — the thresholds are enforced on the ESP32 so
    // cooling keeps working if this web app is down.
    private const double FanOnC  = 28.0;
    private const double FanOffC = 27.0;

    private readonly int[]    sectionSpeeds     = new int[14];
    private readonly string[] sectionDirections = Enumerable.Repeat("forward", 14).ToArray();
    private readonly string[] turnoutPositions  = Enumerable.Repeat("straight", 6).ToArray();

    private Timer? _statusTimer;

    protected override void OnInitialized()
    {
        _statusTimer = new Timer(_ => InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        DetectorStatus.OnDetectionChanged += OnDetectionUpdate;
    }

    private void OnDetectionUpdate() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        DetectorStatus.OnDetectionChanged -= OnDetectionUpdate;
        _statusTimer?.Dispose();
    }

    private static int ParseInt(object? value) =>
        int.TryParse(value?.ToString(), out var n) ? n : 0;

    private static string TempCss(double c) => c switch
    {
        >= 50 => "bg-danger",
        >= 35 => "bg-warning text-dark",
        _     => "bg-success",
    };

    private static string SectionStateCss(DetectorStatusService.SectionState state) => state switch
    {
        DetectorStatusService.SectionState.Occupied => "bg-danger",
        _                                           => "bg-secondary",
    };

    private async Task SendSection(int id, int speed, string direction)
    {
        sectionSpeeds[id - 1] = speed;
        await TrainCommands.SetSection(id, speed, direction);
    }

    private async Task SetDirection(int idx, string direction)
    {
        sectionDirections[idx] = direction;
        await TrainCommands.SetSection(idx + 1, sectionSpeeds[idx], direction);
    }

    private async Task StopSection(int idx)
    {
        sectionSpeeds[idx] = 0;
        await TrainCommands.SetSection(idx + 1, 0, sectionDirections[idx]);
    }

    // No local state — the card renders whatever the firmware last reported,
    // so automatic changes and manual ones are both reflected honestly.
    private Task SetFan(int id, int speed) => TrainCommands.SetFan(id, speed);

    private async Task SendOta(string device)
    {
        otaSent.Add(device);
        await TrainCommands.SendOtaUpdate(device);
    }

    private async Task SetLed(int id, bool on)
    {
        ledOn = on;
        await TrainCommands.SetLed(id, on);
    }

    private async Task SetTurnout(int idx, string position)
    {
        turnoutPositions[idx] = position;
        await TrainCommands.SetTurnout(idx + 1, position);
    }
}
